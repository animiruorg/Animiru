CREATE VIEW historyView AS
SELECT
    history._id AS id,
    anime.id AS animeId,
    episodes._id AS episodeId,
    -- AM -->
    anime.user_custom_title AS custom_title,
    -- <-- AM
    anime.remote_title AS title,
    anime.remote_cover AS thumbnailUrl,
    anime.source_id AS source,
    anime.user_favorite_at IS NOT NULL AS favorite,
    anime.state_cover_last_modified,
    episodes.episode_number AS episodeNumber,
    history.last_seen AS seenAt,
    max_last_seen.last_seen AS maxSeenAt,
    max_last_seen.episode_id AS maxSeenAtEpisodeId
FROM anime
JOIN episodes
ON anime.id = episodes.anime_id
JOIN history
ON episodes._id = history.episode_id
JOIN (
    SELECT episodes.anime_id,episodes._id AS episode_id, MAX(history.last_seen) AS last_seen
    FROM episodes JOIN history
    ON episodes._id = history.episode_id
    GROUP BY episodes.anime_id
) AS max_last_seen
ON episodes.anime_id = max_last_seen.anime_id;

history:
SELECT
id,
animeId,
episodeId,
custom_title,
title,
thumbnailUrl,
source,
favorite,
state_cover_last_modified,
episodeNumber,
seenAt
FROM historyView
WHERE historyView.seenAt > 0
AND maxSeenAtEpisodeId = historyView.episodeId
AND lower(historyView.title) LIKE ('%' || :query || '%')
ORDER BY seenAt DESC;

getLatestHistory:
SELECT
id,
animeId,
episodeId,
custom_title,
title,
thumbnailUrl,
source,
favorite,
state_cover_last_modified,
episodeNumber,
seenAt
FROM historyView
WHERE historyView.seenAt > 0
ORDER BY seenAt DESC
LIMIT 1;
