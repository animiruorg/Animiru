CREATE VIEW updatesView AS
SELECT
    animes._id AS animeId,
    -- AM -->
    animes.custom_title AS customAnimeTitle,
    -- <-- AM
    animes.title AS animeTitle,
    episodes._id AS episodeId,
    episodes.name AS episodeName,
    episodes.scanlator,
    episodes.url AS episodeUrl,
    episodes.seen,
    episodes.bookmark,
    -- AY -->
    episodes.fillermark,
    -- <-- AY
    episodes.last_second_seen,
    -- AY -->
    episodes.total_seconds AS totalSeconds,
    -- <-- AY
    animes.source,
    animes.favorite_at IS NOT NULL AS favorite,
    animes.thumbnail_url AS thumbnailUrl,
    animes.cover_last_modified AS coverLastModified,
    episodes.date_upload AS dateUpload,
    episodes.date_fetch AS datefetch,
    excluded_scanlators.scanlator AS excludedScanlator
FROM animes JOIN episodes
ON animes._id = episodes.anime_id
LEFT JOIN excluded_scanlators
ON animes._id = excluded_scanlators.anime_id
AND episodes.scanlator = excluded_scanlators.scanlator
WHERE favorite_at IS NOT NULL
AND date_fetch > favorite_at
ORDER BY date_fetch DESC;

getRecentUpdates:
SELECT *
FROM updatesView
WHERE dateUpload > :after
LIMIT :limit;

getRecentUpdatesWithFilters:
SELECT *
FROM updatesView
WHERE dateUpload > :after
AND (:seen IS NULL OR seen = :seen)
-- Started means some progress but not finished, Seen means finished episode, thus:
AND (
    :started IS NULL
    OR (:started = 1 AND last_second_seen > 0 AND seen = 0)
    OR (:started = 0 AND last_second_seen = 0 AND seen = 0)
)
AND (:bookmarked IS NULL OR bookmark = :bookmarked)
AND (:fillermarked IS NULL OR fillermark = :fillermarked)
AND (
    (excludedScanlator IS NULL OR :hideExcludedScanlators = 0)
)
AND (
    -- includedEmpty being true expresses "don't care" state and bypasses the membership filter
    :includedEmpty
    OR EXISTS (
        SELECT 1 FROM animes_categories
        WHERE animes_categories.anime_id = animeId
        AND COALESCE(animes_categories.category_id, 0) IN :includedCategories
    )
    OR (0 IN :includedCategories AND NOT EXISTS (
        SELECT 1 FROM animes_categories ac WHERE ac.anime_id = animeId)
    )
)
AND (
    -- excludedEmpty being true expresses "don't care" state and bypasses the membership filter
    :excludedEmpty
    OR (
        NOT EXISTS (
            SELECT 1 FROM animes_categories
            WHERE animes_categories.anime_id = animeId
            AND COALESCE(animes_categories.category_id, 0) IN :excludedCategories
        )
        AND (
            0 NOT IN :excludedCategories
            OR EXISTS (SELECT 1 FROM animes_categories WHERE animes_categories.anime_id = animeId)
        )
    )
)
LIMIT :limit;

getUpdatesBySeenStatus:
SELECT *
FROM updatesView
WHERE seen = :seen
AND dateUpload > :after
LIMIT :limit;
