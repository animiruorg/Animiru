CREATE VIEW updatesView AS
SELECT
    anime.id AS animeId,
    -- AM -->
    anime.user_custom_title AS customAnimeTitle,
    -- <-- AM
    anime.remote_title AS animeTitle,
    episode.id AS episodeId,
    episode.remote_name AS episodeName,
    episode.remote_scanlator AS scanlator,
    episode.remote_url AS episodeUrl,
    episode.user_seen AS seen,
    episode.user_bookmark AS bookmark,
    -- AY -->
    episode.remote_fillermark AS fillermark,
    -- <-- AY
    episode.user_last_second_seen AS lastSecondSeen,
    -- AY -->
    episode.state_total_seconds AS totalSeconds,
    -- <-- AY
    anime.source_id AS sourceId,
    anime.user_favorite_at IS NOT NULL AS favorite,
    anime.remote_cover AS thumbnailUrl,
    anime.state_cover_last_modified AS coverLastModified,
    episode.remote_date_upload AS dateUpload,
    episode.state_date_fetch AS dateFetch,
    excluded_scanlator.scanlator AS excludedScanlator
FROM anime JOIN episode
ON anime.id = episode.anime_id
LEFT JOIN excluded_scanlator
ON anime.id = excluded_scanlator.anime_id
AND episode.remote_scanlator = excluded_scanlator.scanlator
WHERE user_favorite_at IS NOT NULL
AND state_date_fetch > user_favorite_at
ORDER BY state_date_fetch DESC;

getRecentUpdates:
SELECT
    animeId, customAnimeTitle, animeTitle, episodeId, episodeName,
    scanlator, episodeUrl, seen, bookmark, fillermark,
    lastSecondSeen, totalSeconds, sourceId, favorite,
    thumbnailUrl, coverLastModified, dateUpload, dateFetch,
    excludedScanlator
FROM updatesView
WHERE dateUpload > :after
ORDER BY dateFetch DESC
LIMIT :limit;

getRecentUpdatesWithFilters:
SELECT
    animeId, customAnimeTitle, animeTitle, episodeId, episodeName,
    scanlator, episodeUrl, seen, bookmark, fillermark,
    lastSecondSeen, totalSeconds, sourceId, favorite,
    thumbnailUrl, coverLastModified, dateUpload, dateFetch,
    excludedScanlator
FROM updatesView
WHERE dateUpload > :after
AND (:seen IS NULL OR seen = :seen)
-- Started means some progress but not finished, Seen means finished episode, thus:
AND (
    :started IS NULL
    OR (:started = 1 AND lastSecondSeen > 0 AND seen = 0)
    OR (:started = 0 AND lastSecondSeen = 0 AND seen = 0)
)
AND (:bookmarked IS NULL OR bookmark = :bookmarked)
AND (:fillermarked IS NULL OR fillermark = :fillermarked)
AND (
    (excludedScanlator IS NULL OR :hideExcludedScanlators = 0)
)
AND (
    -- includedEmpty being true expresses "don't care" state and bypasses the membership filter
    :includedEmpty
    OR EXISTS (
        SELECT 1 FROM anime_category
        WHERE anime_category.anime_id = animeId
        AND COALESCE(anime_category.category_id, 0) IN :includedCategories
    )
    OR (0 IN :includedCategories AND NOT EXISTS (
        SELECT 1 FROM anime_category ac WHERE ac.anime_id = animeId)
    )
)
AND (
    -- excludedEmpty being true expresses "don't care" state and bypasses the membership filter
    :excludedEmpty
    OR (
        NOT EXISTS (
            SELECT 1 FROM anime_category
            WHERE anime_category.anime_id = animeId
            AND COALESCE(anime_category.category_id, 0) IN :excludedCategories
        )
        AND (
            0 NOT IN :excludedCategories
            OR EXISTS (SELECT 1 FROM anime_category WHERE anime_category.anime_id = animeId)
        )
    )
)
ORDER BY dateFetch DESC
LIMIT :limit;

getUpdatesBySeenStatus:
SELECT
    animeId, customAnimeTitle, animeTitle, episodeId, episodeName,
    scanlator, episodeUrl, seen, bookmark, fillermark,
    lastSecondSeen, totalSeconds, sourceId, favorite,
    thumbnailUrl, coverLastModified, dateUpload, dateFetch,
    excludedScanlator
FROM updatesView
WHERE seen = :seen
AND dateUpload > :after
ORDER BY dateFetch DESC
LIMIT :limit;
