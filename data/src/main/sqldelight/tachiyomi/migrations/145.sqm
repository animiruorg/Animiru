-- Remove the sync scaffolding: version, is_syncing and last_modified_at.

DROP TRIGGER update_anime_version;
DROP TRIGGER update_last_modified_at_animes;
DROP TRIGGER update_episode_and_anime_version;
DROP TRIGGER update_last_modified_at_episodes;
