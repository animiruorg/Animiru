import kotlin.Boolean;

CREATE TABLE anime_track(
    id INTEGER NOT NULL PRIMARY KEY,
    anime_id INTEGER NOT NULL,
    tracker_id INTEGER NOT NULL,
    remote_id INTEGER NOT NULL,
    remote_url TEXT NOT NULL,
    library_id INTEGER,
    title TEXT NOT NULL,
    last_episode_seen REAL NOT NULL,
    total_episodes INTEGER NOT NULL,
    status INTEGER NOT NULL,
    score REAL NOT NULL,
    start_date INTEGER NOT NULL,
    finish_date INTEGER NOT NULL,
    private INTEGER AS Boolean NOT NULL DEFAULT 0,
    UNIQUE (anime_id, tracker_id),
    FOREIGN KEY(anime_id) REFERENCES anime (id)
    ON DELETE CASCADE
);

CREATE INDEX anime_track_tracker_id_remote_id_index ON anime_track(tracker_id, remote_id);

delete:
DELETE FROM anime_track
WHERE anime_id = :animeId AND tracker_id = :syncId;

getTracks:
SELECT
    id, anime_id, tracker_id, remote_id, library_id,
    title, last_episode_seen, total_episodes, start_date, score,
    remote_url, start_date, finish_date, private
FROM anime_track;

getTrackById:
SELECT
    id, anime_id, tracker_id, remote_id, library_id,
    title, last_episode_seen, total_episodes, start_date, score,
    remote_url, start_date, finish_date, private
FROM anime_track
WHERE id = :id;

getTracksByAnimeId:
SELECT
    id, anime_id, tracker_id, remote_id, library_id,
    title, last_episode_seen, total_episodes, start_date, score,
    remote_url, start_date, finish_date, private
FROM anime_track
WHERE anime_id = :animeId;

upsert:
INSERT INTO anime_track(anime_id,tracker_id,remote_id,library_id,title,last_episode_seen,total_episodes,status,score,remote_url,start_date,finish_date,private)
VALUES (:animeId,:syncId,:remoteId,:libraryId,:title,:lastEpisodeSeen,:totalEpisodes,:status,:score,:remoteUrl,:startDate,:finishDate,:private)
ON CONFLICT(anime_id, tracker_id)
DO UPDATE
SET
    remote_id = :remoteId,
    library_id = :libraryId,
    title = :title,
    last_episode_seen = :lastEpisodeSeen,
    total_episodes = :totalEpisodes,
    status = :status,
    score = :score,
    remote_url = :remoteUrl,
    start_date = :startDate,
    finish_date = :finishDate,
    private = :private
WHERE anime_id = :animeId AND tracker_id = :syncId;

update:
UPDATE anime_track
SET
    anime_id = coalesce(:animeId, anime_id),
    tracker_id = coalesce(:syncId, tracker_id),
    remote_id = coalesce(:mediaId, remote_id),
    library_id = coalesce(:libraryId, library_id),
    title = coalesce(:title, title),
    last_episode_seen = coalesce(:lastEpisodeSeen, last_episode_seen),
    total_episodes = coalesce(:totalEpisodes, total_episodes),
    status = coalesce(:status, status),
    score = coalesce(:score, score),
    remote_url = coalesce(:trackingUrl, remote_url),
    start_date = coalesce(:startDate, start_date),
    finish_date = coalesce(:finishDate, finish_date),
    private = coalesce(:private, private)
WHERE id = :id;
