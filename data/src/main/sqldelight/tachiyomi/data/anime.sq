-- AM -->
updateCustomInformation:
UPDATE anime SET
    user_custom_artist = :customArtist,
    user_custom_author = :customAuthor,
    user_custom_description = :customDescription,
    user_custom_genre = :customGenre,
    user_custom_title = :customTitle,
    user_custom_status = :customStatus
WHERE id = :animeId;
-- <-- AM

insertNetworkAnime {
    -- Insert the anime if it doesn't exist already
    INSERT INTO anime(
        source_id, remote_url, remote_artist, remote_author, remote_description, remote_genre, remote_title, remote_status, remote_cover, user_favorite_at,
        state_episode_last_update, state_episode_next_update, state_initialized, user_player_flags, user_episode_flags, state_cover_last_modified,
        remote_update_strategy, state_episode_fetch_interval, user_notes, remote_fetch_type, state_parent_id, user_season_flags,
        remote_season_number, remote_season_source_order, remote_background, state_background_last_modified, remote_memo
    )
    SELECT
        :source, :url, :artist, :author, :description, :genre, :title, :status, :thumbnailUrl, :favoriteAt,
        :lastUpdate, :nextUpdate, :initialized, :viewerFlags, :episodeFlags, :coverLastModified,
        :updateStrategy, :calculateInterval, '', :fetchType, :parentId, :seasonFlags, :seasonNumber,
        :seasonSourceOrder, :backgroundUrl, :backgroundLastModified, :memo
    WHERE NOT EXISTS(SELECT 0 FROM anime WHERE source_id = :source AND remote_url = :url);

    -- Update the relevant details if applicable and not favorite
    UPDATE anime
    SET
        remote_title = CASE WHEN :updateTitle THEN :title ELSE remote_title END,
        remote_cover = CASE WHEN :updateCover THEN :thumbnailUrl ELSE remote_cover END,
        remote_author = CASE WHEN :updateDetails THEN :author ELSE remote_author END,
        remote_artist = CASE WHEN :updateDetails THEN :artist ELSE remote_artist END,
        remote_description = CASE WHEN :updateDetails THEN :description ELSE remote_description END,
        remote_genre = CASE WHEN :updateDetails THEN :genre ELSE remote_genre END,
        remote_status = CASE WHEN :updateDetails THEN :status ELSE remote_status END,
        remote_update_strategy = CASE WHEN :updateDetails THEN :updateStrategy ELSE remote_update_strategy END,
        state_initialized = :updateDetails,
        -- AY -->
        remote_season_number = CASE WHEN :updateDetails THEN :seasonNumber ELSE remote_season_number END,
        remote_season_source_order = CASE WHEN :updateDetails THEN :seasonSourceOrder ELSE remote_season_source_order END,
        remote_background = CASE WHEN :updateDetails THEN :backgroundUrl ELSE remote_background END,
        -- <-- AY
        remote_memo = :memo
    WHERE source_id = :source
    AND remote_url = :url
    AND user_favorite_at IS NULL;

    -- Finally return the anime
    SELECT
        id, source_id, remote_url, remote_artist, remote_author, remote_description, remote_genre, remote_title,
        remote_status, remote_cover, state_episode_last_update, state_episode_next_update, state_initialized,
        user_player_flags, user_episode_flags, state_cover_last_modified, remote_update_strategy,
        state_episode_fetch_interval, user_notes, remote_fetch_type, state_parent_id, user_season_flags,
        remote_season_number, remote_season_source_order, remote_background, state_background_last_modified,
        remote_memo, user_favorite_at, user_custom_artist, user_custom_author, user_custom_description,
        user_custom_genre, user_custom_title, user_custom_status
    FROM anime
    WHERE source_id = :source
    AND remote_url = :url
    LIMIT 1;
}
