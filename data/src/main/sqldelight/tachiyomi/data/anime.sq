-- AM -->
updateCustomInformation:
UPDATE anime SET
    user_custom_artist = :customArtist,
    user_custom_author = :customAuthor,
    user_custom_description = :customDescription,
    user_custom_genre = :customGenre,
    user_custom_title = :customTitle,
    user_custom_status = :customStatus
WHERE id = :animeId;
-- <-- AM

insertNetworkAnime {
    -- A new entry is inserted as the source reported it. An existing one takes the fresh details
    -- only while it is outside the library, so a library entry keeps what the user already has.
    INSERT INTO anime(
        source_id, remote_url, remote_title, remote_author, remote_artist, remote_description,
        remote_genre, remote_status, remote_cover, remote_update_strategy, remote_memo,
        remote_fetch_type, remote_season_number, remote_season_source_order, remote_background,
        user_favorite_at, user_notes, user_player_flags, user_episode_flags, user_season_flags,
        user_custom_artist, user_custom_author, user_custom_description, user_custom_genre,
        user_custom_title, user_custom_status, state_episode_last_update, state_episode_next_update,
        state_episode_fetch_interval, state_cover_last_modified, state_initialized,
        state_parent_id, state_background_last_modified
    )
    VALUES (
        :sourceId, :remoteUrl, :remoteTitle, :remoteAuthor, :remoteArtist, :remoteDescription,
        :remoteGenre, :remoteStatus, :remoteCover, :remoteUpdateStrategy, :remoteMemo,
        :remoteFetchType, :remoteSeasonNumber, :remoteSeasonSourceOrder, :remoteBackground,
        :userFavoriteAt, '', :userPlayerFlags, :userEpisodeFlags, :userSeasonFlags,
        NULL, NULL, NULL, NULL, NULL, NULL, :stateEpisodeLastUpdate, :stateEpisodeNextUpdate,
        :stateEpisodeFetchInterval, :stateCoverLastModified, :stateInitialized, :stateParentId,
        :stateBackgroundLastModified
    )
    ON CONFLICT(source_id, remote_url) DO UPDATE SET
        remote_title = CASE WHEN :updateTitle THEN excluded.remote_title ELSE remote_title END,
        remote_cover = CASE WHEN :updateCover THEN excluded.remote_cover ELSE remote_cover END,
        remote_author = CASE WHEN :updateDetails THEN excluded.user_custom_author ELSE remote_author END,
        remote_artist = CASE WHEN :updateDetails THEN excluded.remote_artist ELSE remote_artist END,
        remote_description = CASE WHEN :updateDetails THEN excluded.remote_description ELSE remote_description END,
        remote_genre = CASE WHEN :updateDetails THEN excluded.remote_genre ELSE remote_genre END,
        remote_status = CASE WHEN :updateDetails THEN excluded.remote_status ELSE remote_status END,
        remote_update_strategy = CASE
            WHEN :updateDetails THEN excluded.remote_update_strategy
            ELSE remote_update_strategy
        END,
        remote_memo = excluded.remote_memo,
        -- AY -->
        remote_season_number = CASE WHEN :updateDetails THEN excluded.remote_season_number ELSE remote_season_number END,
        remote_season_source_order = CASE WHEN :updateDetails THEN excluded.remote_season_source_order ELSE remote_season_source_order END,
        remote_background = CASE WHEN :updateDetails THEN excluded.remote_background ELSE remote_background END,
        -- <-- AY
        state_initialized = :updateDetails
    WHERE user_favorite_at IS NULL;

    SELECT
        id, source_id, remote_url, remote_title, remote_author, remote_artist, remote_description,
        remote_genre, remote_status, remote_cover, remote_update_strategy, remote_memo,
        remote_fetch_type, remote_season_number, remote_season_source_order, remote_background,
        user_favorite_at, user_notes, user_player_flags, user_episode_flags, user_season_flags,
        user_custom_artist, user_custom_author, user_custom_description, user_custom_genre,
        user_custom_title, user_custom_status, state_episode_last_update, state_episode_next_update,
        state_episode_fetch_interval, state_cover_last_modified, state_initialized,
        state_parent_id, state_background_last_modified
    FROM anime
    WHERE source_id = :sourceId
    AND remote_url = :remoteUrl;
}
