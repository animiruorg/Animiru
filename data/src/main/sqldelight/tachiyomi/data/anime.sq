getDuplicateLibraryAnime:
WITH
track_dupes AS (
    SELECT DISTINCT T2.anime_id
    FROM anime_track T1
    INNER JOIN anime_track T2
    ON T1.tracker_id = T2.tracker_id
    AND T1.remote_id = T2.remote_id
    AND T1.remote_id != 0
    AND T1.anime_id != T2.anime_id
    WHERE T1.anime_id = :id
)
SELECT
    A.id, A.source_id, A.remote_url, A.remote_title, A.remote_author, A.remote_artist, A.remote_description,
    A.remote_genre, A.remote_status, A.remote_cover, A.remote_update_strategy, A.remote_memo,
    A.remote_fetch_type, A.remote_season_number, A.remote_season_source_order, A.remote_background,
    A.user_favorite_at, A.user_notes, A.user_player_flags, A.user_episode_flags, A.user_season_flags,
    A.user_custom_artist, A.user_custom_author, A.user_custom_description, A.user_custom_genre,
    A.user_custom_title, A.user_custom_status, A.state_episode_last_update, A.state_episode_next_update,
    A.state_episode_fetch_interval, A.state_cover_last_modified, A.state_initialized,
    A.state_parent_id, A.state_background_last_modified,
    (
        SELECT count(*)
        FROM episode EP
        LEFT JOIN excluded_scanlator ES
        ON EP.anime_id = ES.anime_id
        AND EP.remote_scanlator = ES.scanlator
        WHERE EP.anime_id = A.id
        AND ES.scanlator IS NULL
    ) AS episode_count
FROM anime A
WHERE A.user_favorite_at IS NOT NULL
AND A.id != :id
-- A blank title would match every title
AND (
    (trim(:remoteTitle) != '' AND lower(A.remote_title) LIKE '%' || lower(:remoteTitle) || '%')
    OR A.id IN (SELECT anime_id FROM track_dupes)
);

getUpcomingAnime:
SELECT
    id, source_id, remote_url, remote_title, remote_author, remote_artist, remote_description,
    remote_genre, remote_status, remote_cover, remote_update_strategy, remote_memo,
    remote_fetch_type, remote_season_number, remote_season_source_order, remote_background,
    user_favorite_at, user_notes, user_player_flags, user_episode_flags, user_season_flags,
    user_custom_artist, user_custom_author, user_custom_description, user_custom_genre,
    user_custom_title, user_custom_status, state_episode_last_update, state_episode_next_update,
    state_episode_fetch_interval, state_cover_last_modified, state_initialized,
    state_parent_id, state_background_last_modified
FROM anime
WHERE state_episode_next_update >= :startOfDay
AND user_favorite_at IS NOT NULL
AND remote_status IN :statuses
AND (
    -- includedEmpty being true expresses "don't care" state and bypasses the membership filter
    :includedEmpty
    OR EXISTS (
        SELECT 1 FROM anime_category
        WHERE anime_category.anime_id = anime.id
        AND anime_category.category_id IN :includedCategories
    )
    OR (0 IN :includedCategories AND NOT EXISTS (
        SELECT 1 FROM anime_category WHERE anime_category.anime_id = anime.id)
    )
)
AND (
    -- excludedEmpty being true expresses "don't care" state and bypasses the membership filter
    :excludedEmpty
    OR (
        NOT EXISTS (
            SELECT 1 FROM anime_category
            WHERE anime_category.anime_id = anime.id
            AND anime_category.category_id IN :excludedCategories
        )
        AND (
            0 NOT IN :excludedCategories
            OR EXISTS (SELECT 1 FROM anime_category WHERE anime_category.anime_id = anime.id)
        )
    )
)
ORDER BY state_episode_next_update ASC;

resetViewerFlags:
UPDATE anime
SET user_player_flags = 0
WHERE user_player_flags != 0;

-- AM -->
removeParentIdByIds:
UPDATE anime
SET state_parent_id = NULL
WHERE id IN :animeIds;

getChildrenByParentId:
SELECT
    id, source_id, remote_url, remote_title, remote_author, remote_artist, remote_description,
    remote_genre, remote_status, remote_cover, remote_update_strategy, remote_memo,
    remote_fetch_type, remote_season_number, remote_season_source_order, remote_background,
    user_favorite_at, user_notes, user_player_flags, user_episode_flags, user_season_flags,
    user_custom_artist, user_custom_author, user_custom_description, user_custom_genre,
    user_custom_title, user_custom_status, state_episode_last_update, state_episode_next_update,
    state_episode_fetch_interval, state_cover_last_modified, state_initialized,
    state_parent_id, state_background_last_modified
FROM anime
WHERE state_parent_id = :parentId;
-- <-- AM

deleteNonLibraryAnimeByAnimeIds:
DELETE FROM anime
WHERE user_favorite_at IS NULL
-- AM -->
AND id IN :animeIds
-- <-- AM
AND (
    :keepSeenAnime = 0
    OR NOT EXISTS (
        SELECT 1
        FROM episode
        WHERE episode.anime_id = anime.id
        AND (user_seen = 1 OR user_last_second_seen != 0)
    )
);

insertReturningId:
INSERT INTO anime(
    source_id, remote_url, remote_title, remote_author, remote_artist, remote_description,
    remote_genre, remote_status, remote_cover, remote_update_strategy, remote_memo,
    remote_fetch_type, remote_season_number, remote_season_source_order, remote_background,
    user_favorite_at, user_notes, user_player_flags, user_episode_flags, user_season_flags,
    user_custom_artist, user_custom_author, user_custom_description, user_custom_genre,
    user_custom_title, user_custom_status, state_episode_last_update, state_episode_next_update,
    state_episode_fetch_interval, state_cover_last_modified, state_initialized,
    state_parent_id, state_background_last_modified
)
VALUES (
    :sourceId, :remoteUrl, :remoteTitle, :remoteAuthor, :remoteArtist, :remoteDescription,
    :remoteGenre, :remoteStatus, :remoteCover, :remoteUpdateStrategy, :remoteMemo,
    :remoteFetchType, :remoteSeasonNumber, :remoteSeasonSourceOrder, :remoteBackground,
    :userFavoriteAt, :userNotes, :userPlayerFlags, :userEpisodeFlags, :userSeasonFlags,
    NULL, NULL, NULL, NULL, NULL, NULL, :stateEpisodeLastUpdate, :stateEpisodeNextUpdate,
    :stateEpisodeFetchInterval, :stateCoverLastModified, :stateInitialized, :stateParentId,
    :stateBackgroundLastModified
)
RETURNING id;

update:
UPDATE anime SET
    -- NULL is a real value here (not in the library), which coalesce cannot write
    user_favorite_at = CASE WHEN :userFavoriteAtSet THEN :userFavoriteAt ELSE user_favorite_at END,
    user_notes = coalesce(:userNotes, user_notes),
    user_player_flags = coalesce(:userPlayerFlags, user_player_flags),
    user_episode_flags = coalesce(:userEpisodeFlags, user_episode_flags),
    -- AM -->
    user_season_flags = coalesce(:userSeasonFlags, user_season_flags),
    -- <-- AM
    state_episode_last_update = coalesce(:stateEpisodeLastUpdate, state_episode_last_update),
    state_episode_next_update = coalesce(:stateEpisodeNextUpdate, state_episode_next_update),
    state_episode_fetch_interval = coalesce(:stateEpisodeFetchInterval, state_episode_fetch_interval),
    state_cover_last_modified = coalesce(:stateCoverLastModified, state_cover_last_modified),
    -- AM -->
    state_parent_id = CASE WHEN :stateParentIdSet THEN :stateParentId ELSE state_parent_id END,
    state_background_last_modified = coalesce(:stateBackgroundLastModified, state_background_last_modified)
    -- <-- AM
WHERE id = :id;

updateFromBackup:
UPDATE anime SET
    remote_title = coalesce(:remoteTitle, remote_title),
    remote_author = coalesce(:remoteAuthor, remote_author),
    remote_artist = coalesce(:remoteArtist, remote_artist),
    remote_description = coalesce(:remoteDescription, remote_description),
    remote_genre = coalesce(:remoteGenre, remote_genre),
    remote_status = coalesce(:remoteStatus, remote_status),
    remote_cover = coalesce(:remoteCover, remote_cover),
    remote_update_strategy = coalesce(:remoteUpdateStrategy, remote_update_strategy),
    remote_memo = coalesce(:remoteMemo, remote_memo),
    -- AM -->
    remote_fetch_type = coalesce(:remoteFetchType, remote_fetch_type),
    remote_season_number = coalesce(:remoteSeasonNumber, remote_season_number),
    remote_season_source_order = coalesce(:remoteSeasonSourceOrder, remote_season_source_order),
    remote_background = coalesce(:remoteBackground, remote_background),
    -- <-- AM
    user_favorite_at = :userFavoriteAt,
    user_notes = coalesce(:userNotes, user_notes),
    user_player_flags = coalesce(:userPlayerFlags, user_player_flags),
    user_episode_flags = coalesce(:userEpisodeFlags, user_episode_flags),
    -- AM -->
    user_season_flags = coalesce(:userSeasonFlags, user_season_flags),
    -- <-- AM
    state_episode_last_update = coalesce(:stateEpisodeLastUpdate, state_episode_last_update),
    state_cover_last_modified = coalesce(:stateCoverLastModified, state_cover_last_modified),
    state_initialized = coalesce(:stateInitialized, state_initialized),
    -- AM -->
    state_parent_id = coalesce(:stateParentId, state_parent_id),
    state_background_last_modified = coalesce(:stateBackgroundLastModified, state_background_last_modified)
    -- <-- AM
WHERE id = :id;

