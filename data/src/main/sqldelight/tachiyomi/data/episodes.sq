import kotlin.Boolean;
import kotlinx.serialization.json.JsonObject;

CREATE TABLE episodes(
    _id INTEGER NOT NULL PRIMARY KEY,
    anime_id INTEGER NOT NULL,
    url TEXT NOT NULL,
    name TEXT NOT NULL,
    scanlator TEXT,
    seen INTEGER AS Boolean NOT NULL,
    bookmark INTEGER AS Boolean NOT NULL,
    -- AY -->
    fillermark INTEGER AS Boolean NOT NULL,
    -- <-- AY
    last_second_seen INTEGER NOT NULL,
    -- AY -->
    total_seconds INTEGER NOT NULL,
    -- <-- AY
    episode_number REAL NOT NULL,
    source_order INTEGER NOT NULL,
    date_fetch INTEGER NOT NULL,
    date_upload INTEGER NOT NULL,
    -- AY -->
    summary TEXT,
    preview_url TEXT,
    -- <-- AY
    memo BLOB AS JsonObject NOT NULL DEFAULT '{}',
    -- AM -->
    thumbnail_last_modified_at INTEGER NOT NULL DEFAULT 0,
    -- <-- AM
    FOREIGN KEY(anime_id) REFERENCES animes (_id)
    ON DELETE CASCADE
);

CREATE INDEX episodes_anime_id_index ON episodes(anime_id);
CREATE INDEX episodes_unseen_by_anime_index ON episodes(anime_id, seen) WHERE seen = 0;
CREATE INDEX idx_episodes_url ON episodes(url);

getEpisodeById:
SELECT *
FROM episodes
WHERE _id = :id;

getEpisodesByAnimeId:
SELECT EP.*
FROM episodes EP
LEFT JOIN excluded_scanlators ES
ON EP.anime_id = ES.anime_id
AND EP.scanlator = ES.scanlator
WHERE EP.anime_id = :animeId
AND (
    :applyScanlatorFilter = 0
    OR ES.scanlator IS NULL
);

getScanlatorsByAnimeId:
SELECT scanlator
FROM episodes
WHERE anime_id = :animeId;

getBookmarkedEpisodesByAnimeId:
SELECT *
FROM episodes
WHERE bookmark
AND anime_id = :animeId;

getEpisodeByUrl:
SELECT *
FROM episodes
WHERE url = :episodeUrl;

getEpisodeByUrlAndAnimeId:
SELECT *
FROM episodes
WHERE url = :episodeUrl
AND anime_id = :animeId
LIMIT 1;

removeEpisodesWithIds:
DELETE FROM episodes
WHERE _id IN :episodeIds;

insert:
INSERT INTO episodes(anime_id, url, name, scanlator, seen, bookmark, fillermark, last_second_seen, total_seconds, episode_number, source_order, date_fetch, date_upload, summary, preview_url, memo, thumbnail_last_modified_at)
VALUES (:animeId, :url, :name, :scanlator, :seen, :bookmark, :fillermark, :lastSecondSeen, :totalSeconds, :episodeNumber, :sourceOrder, :dateFetch, :dateUpload, :summary, :previewUrl, :memo, 0);

insertReturningId:
INSERT INTO episodes(anime_id, url, name, scanlator, seen, bookmark, fillermark, last_second_seen, total_seconds, episode_number, source_order, date_fetch, date_upload, summary, preview_url, memo, thumbnail_last_modified_at)
VALUES (:animeId, :url, :name, :scanlator, :seen, :bookmark, :fillermark, :lastSecondSeen, :totalSeconds, :episodeNumber, :sourceOrder, :dateFetch, :dateUpload, :summary, :previewUrl, :memo, 0)
RETURNING _id;

update:
UPDATE episodes
SET seen = coalesce(:seen, seen),
    bookmark = coalesce(:bookmark, bookmark),
    -- AY -->
    fillermark = coalesce(:fillermark, fillermark),
    -- <-- AY
    last_second_seen = coalesce(:lastSecondSeen, last_second_seen),
    -- AY -->
    total_seconds = coalesce(:totalSeconds, total_seconds),
    -- <-- AY
    date_fetch = coalesce(:dateFetch, date_fetch),
    -- AM -->
    thumbnail_last_modified_at = coalesce(:thumbnailLastModifiedAt, thumbnail_last_modified_at)
    -- <-- AM
WHERE _id = :episodeId;

updateFromBackup:
UPDATE episodes
SET seen = coalesce(:seen, seen),
    bookmark = coalesce(:bookmark, bookmark),
    -- AY -->
    fillermark = coalesce(:fillermark, fillermark),
    -- <-- AY
    last_second_seen = coalesce(:lastSecondSeen, last_second_seen),
    -- AY -->
    total_seconds = coalesce(:totalSeconds, total_seconds),
    -- <-- AY
    memo = coalesce(:memo, memo),
    -- AM -->
    thumbnail_last_modified_at = coalesce(:thumbnailLastModifiedAt, thumbnail_last_modified_at)
    -- <-- AM
WHERE _id = :episodeId;

updateRemote:
UPDATE episodes
SET name = :name,
    scanlator = coalesce(:scanlator, scanlator),
    episode_number = :episodeNumber,
    source_order = :sourceOrder,
    date_upload = coalesce(:dateUpload, date_upload),
    -- AY -->
    fillermark = coalesce(:fillermark, fillermark),
    summary = coalesce(:summary, summary),
    preview_url = coalesce(:previewUrl, preview_url),
    -- <-- AY
    memo = coalesce(:memo, memo),
    -- AM -->
    thumbnail_last_modified_at = coalesce(:thumbnailLastModifiedAt, thumbnail_last_modified_at)
    -- <-- AM
WHERE _id = :episodeId;
