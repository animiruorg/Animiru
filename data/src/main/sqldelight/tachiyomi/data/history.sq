import kotlin.time.Instant;

CREATE TABLE history(
    id INTEGER NOT NULL PRIMARY KEY,
    anime_id INTEGER NOT NULL,
    episode_id INTEGER NOT NULL UNIQUE,
    seen_at INTEGER AS Instant,
    FOREIGN KEY(anime_id) REFERENCES anime (id)
    ON DELETE CASCADE,
    FOREIGN KEY(episode_id) REFERENCES episode (id)
    ON DELETE CASCADE
);

CREATE INDEX history_anime_id_index ON history(anime_id);
CREATE INDEX history_seen_at_index ON history(seen_at);

getHistoryByAnimeId:
SELECT id, episode_id, seen_at
FROM history
WHERE anime_id = :animeId;

resetHistoryById:
UPDATE history
SET seen_at = NULL
WHERE id = :id;

resetHistoryByAnimeId:
UPDATE history
SET seen_at = NULL
WHERE anime_id = :animeId;

removeAllHistory:
DELETE FROM history;

removeResettedHistory:
DELETE FROM history
WHERE seen_at IS NULL;

upsert:
INSERT INTO history(anime_id, episode_id, seen_at)
SELECT anime_id, id, :seenAt
FROM episode
WHERE id = :episodeId
ON CONFLICT(episode_id) DO UPDATE SET
    seen_at = excluded.seen_at;
