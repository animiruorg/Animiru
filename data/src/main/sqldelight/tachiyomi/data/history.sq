import java.util.Date;

CREATE TABLE history(
    id INTEGER NOT NULL PRIMARY KEY,
    anime_id INTEGER NOT NULL,
    episode_id INTEGER NOT NULL UNIQUE,
    seen_at INTEGER AS Date,
    FOREIGN KEY(anime_id) REFERENCES anime (id)
    ON DELETE CASCADE,
    FOREIGN KEY(episode_id) REFERENCES episode (id)
    ON DELETE CASCADE
);

CREATE INDEX history_anime_id_index ON history(anime_id);
CREATE INDEX history_seen_at_index ON history(seen_at);

getHistoryByAnimeId:
SELECT
H.id,
H.episode_id,
H.seen_at
FROM history H
WHERE H.anime_id = :animeId;

getHistoryByEpisodeUrlAndAnimeId:
SELECT
H.id,
H.episode_id,
H.seen_at
FROM history H
JOIN episode EP
ON H.episode_id = EP.id
WHERE EP.remote_url = :episodeUrl AND EP.anime_id = :animeId
LIMIT 1;

resetHistoryById:
UPDATE history
SET seen_at = 0
WHERE id = :historyId;

resetHistoryByAnimeId:
UPDATE history
SET seen_at = 0
WHERE anime_id = :animeId;

removeAllHistory:
DELETE FROM history;

removeResettedHistory:
DELETE FROM history
WHERE seen_at = 0;

upsert:
INSERT INTO history(anime_id, episode_id, seen_at)
SELECT EP.anime_id, :episodeId, :seenAt
FROM episode EP
WHERE EP.id = :episodeId
ON CONFLICT(episode_id)
DO UPDATE
SET
    seen_at = :seenAt
WHERE episode_id = :episodeId;
